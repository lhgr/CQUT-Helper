<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/widget_card"
        android:layout_gravity="center"
        android:padding="12dp"
        android:background="@drawable/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/rl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_schedule_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_primary_text"
                android:maxLines="1"
                android:maxLength="12"
                android:text="课表" />
            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxWidth="72dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="9sp"
                android:textColor="@color/widget_secondary_text"
                android:visibility="gone" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_secondary_text"
                android:layout_marginEnd="4dp"
                android:text="3.26" />
            <TextView
                android:id="@+id/tv_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/widget_accent"
                android:text="周六" />
            <ImageView
                android:id="@+id/iv_refresh"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:padding="2dp"
                android:contentDescription="刷新课表"
                android:src="@android:drawable/ic_popup_sync"
                android:visibility="gone" />
        </LinearLayout>
        <ListView
            android:id="@+id/lv_course"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rl_title"
            android:layout_alignParentBottom="true"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rl_title"
            android:layout_alignParentBottom="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/widget_secondary_text"
            android:lineSpacingExtra="8dp"
            android:textAlignment="center"
            android:text="暂无课程" />
        <ImageView
            android:id="@+id/theme_transition_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@android:color/transparent"
            android:background="#00000000"
            android:visibility="gone" />
    </RelativeLayout>
</FrameLayout>
